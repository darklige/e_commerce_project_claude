# 根 .gitignore：只放跨端通用规则
# 各语言/框架专属规则放在对应 workspace 的 .gitignore
#   - Python:  backend/.gitignore
#   - Node/Next.js: 各 frontend-*/.gitignore
#   - Android/Gradle: android-app/.gitignore

# ============ OS ============
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ============ Editors / IDEs ============
.vscode/
.idea/
*.iml
.claude/settings.local.json
.claude/*.local.json
*.code-workspace
.history/

# ============ Env / Secrets ============
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets/
*.jks
*.keystore

# ============ Logs & Temp ============
*.log
logs/
# Next.js App Router 路由目录名恰为 logs，需显式放行
!frontend-admin/src/app/(console)/console/logs/
!frontend-admin/src/app/(console)/console/logs/**
tmp/
temp/
*.bak

# ============ Docker ============
docker-compose.override.yml
.docker/

# ============ Node / pnpm workspace 虚拟 store ============
# 各 workspace 自己的 node_modules 由各自的 .gitignore 兜底，这里防止
# pnpm 在根目录建 node_modules/.pnpm/ 时被误提交
node_modules/
.pnpm-store/

# ============ Database / Storage (本地卷) ============
*.sqlite
*.sqlite3
*.db
dumps/
backups/
minio-data/
storage/
uploads/
